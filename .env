# ==============================================================================
# InfraScan - AI-Powered Damage Assessment for Civil Infrastructure
# Module 1: Authentication & Role-Based Access Control (RBAC) Environment Config
# ==============================================================================

# Application Settings
APP_NAME="InfraScan API"
ENVIRONMENT=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
# Synchronous (for Alembic migrations and sync scripts)
DATABASE_URL=postgresql+psycopg://infrascan_user:InfosysSP-Team3@localhost:5432/infrascan_db

# Asynchronous (for FastAPI asyncpg operations)
ASYNC_DATABASE_URL=postgresql+asyncpg://infrascan_user:InfosysSP-Team3@localhost:5432/infrascan_db

# JWT & Session Security
# Generate secure keys via terminal: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=94c8b2ec045582f32a76f244199c15984dc09ee06573752e2e92c2ee03e4ee7b
SESSION_SECRET_KEY=b15802a281e8cbcf4c80467b7f1e73ea2fdf6c6a4959dbbebcba3c38b255ccaa
ALGORITHM=HS256

# Token Lifecycle Policies (Module 1 Requirements)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth2 Credentials (via Google Cloud Console)
# Authorized Redirect URI must match: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# First Seed Administrator Credentials
FIRST_ADMIN_EMAIL=admin@infrascan.gov
FIRST_ADMIN_PASSWORD=Admin@Secure2026!
FIRST_ADMIN_NAME="System Administrator"

# Runtime Storage
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=15
